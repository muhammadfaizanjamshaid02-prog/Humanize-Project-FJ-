# HumanizeAI server — OPTIONAL settings. Copy to ".env" only if you want
# to use a real LLM. With NO keys set, the server runs in demo mode:
# a built-in rule-based engine that works fully offline.

# Use ONE of these (OpenAI takes priority if both are set):
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides (OpenAI-compatible endpoint + model name):
LLM_BASE_URL=
LLM_MODEL=

# Optional server port (default 5000):
PORT=5000
